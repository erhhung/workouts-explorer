ARG OSM_RUNTIME_IMAGE
FROM docker.io/library/golang:1.26-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY worker ./worker
COPY internal ./internal
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/osm-update ./worker/cmd/osm-update

# Supply an immutable approved runtime with the exact pinned osmium/osm2pgsql
# tool versions; changing the controller does not rebuild geospatial toolchains.
FROM ${OSM_RUNTIME_IMAGE}
COPY --from=build /out/osm-update /app/osm-update
COPY osm /app/osm
USER 65532:65532
ENTRYPOINT ["/app/osm-update"]

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["image", "logging", "ui", "api", "tileServer", "worker", "coverageWorker", "osm", "sources", "otel", "ingress"],
  "properties": {
    "image": {"type": "object", "additionalProperties": false, "required": ["registry", "pullPolicy", "pullSecrets", "tag"], "properties": {"registry": {"type": "string"}, "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]}, "pullSecrets": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["name"], "properties": {"name": {"type": "string", "minLength": 1}}}}, "tag": {"type": "string"}}},
    "logging": {"type": "object", "additionalProperties": false, "required": ["format"], "properties": {"format": {"enum": ["json", "text"]}}},
    "ui": {"$ref": "#/$defs/component"},
    "tileServer": {"type": "object", "additionalProperties": false, "required": ["image", "replicas", "databaseSecret", "resources"], "properties": {"image": {"type": "string", "pattern": "^ghcr\\.io/maplibre/martin:[^@]+@sha256:[a-f0-9]{64}$"}, "replicas": {"type": "integer", "minimum": 1}, "databaseSecret": {"$ref": "#/$defs/secretRef"}, "resources": {"type": "object"}}},
    "api": {
      "type": "object", "additionalProperties": false,
      "required": ["image", "replicas", "publicUrl", "browserSigninOrigins", "databaseSecret", "migrationDatabaseKey", "roleProvisioning", "securitySecret", "trustedCASecret", "passwordMinimumLength", "sessionLifetime", "pageSizeMaximum", "trustedProxyCidrs", "localDevelopment", "coverageDiagnostics", "smtp", "bootstrap", "publicConfig", "resources"],
      "properties": {
        "image": {"type": "string", "minLength": 1}, "replicas": {"type": "integer", "minimum": 1}, "publicUrl": {"type": "string", "format": "uri"}, "browserSigninOrigins": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "format": "uri"}},
        "databaseSecret": {"$ref": "#/$defs/secretRef"}, "migrationDatabaseKey": {"type": "string", "minLength": 1},
        "roleProvisioning": {"type": "object", "additionalProperties": false, "required": ["enabled", "secretName", "databaseKey"], "properties": {"enabled": {"type": "boolean"}, "secretName": {"type": "string", "minLength": 1}, "databaseKey": {"type": "string", "minLength": 1}}},
        "securitySecret": {"type": "object", "additionalProperties": false, "required": ["name", "rateLimitKey", "smtpPasswordKey"], "properties": {"name": {"type": "string", "minLength": 1}, "rateLimitKey": {"type": "string", "minLength": 1}, "smtpPasswordKey": {"type": "string", "minLength": 1}}},
        "trustedCASecret": {"$ref": "#/$defs/secretRef"},
        "passwordMinimumLength": {"type": "integer", "minimum": 12, "maximum": 64}, "sessionLifetime": {"type": "string", "pattern": "^[1-9][0-9]*(m|h)$"}, "pageSizeMaximum": {"type": "integer", "minimum": 25, "maximum": 1000}, "trustedProxyCidrs": {"type": "string"}, "localDevelopment": {"type": "boolean"},
        "coverageDiagnostics": {"type": "object", "additionalProperties": false, "required": ["enabled", "timeout", "concurrency", "osmDatabaseKey", "databaseTLSSecret", "motorLaneWidthMeters", "bicycleLaneWidthMeters", "parkingLaneWidthMeters", "sidewalkSetbackMeters", "directionalDriftMeters", "deadEndEndpointAllowanceMeters"], "properties": {"enabled": {"type": "boolean"}, "timeout": {"type": "string", "pattern": "^(([5-9]|[1-9][0-9]|1[01][0-9]|120)s)$"}, "concurrency": {"type": "integer", "minimum": 1, "maximum": 4}, "osmDatabaseKey": {"type": "string", "minLength": 1}, "databaseTLSSecret": {"type": "string", "minLength": 1}, "motorLaneWidthMeters": {"type": "number", "minimum": 2.5, "maximum": 4}, "bicycleLaneWidthMeters": {"type": "number", "minimum": 1, "maximum": 2.5}, "parkingLaneWidthMeters": {"type": "number", "minimum": 1.5, "maximum": 3}, "sidewalkSetbackMeters": {"type": "number", "minimum": 1, "maximum": 5}, "directionalDriftMeters": {"type": "number", "minimum": 0, "maximum": 10}, "deadEndEndpointAllowanceMeters": {"type": "number", "minimum": 0, "maximum": 10}}},
        "smtp": {"type": "object", "additionalProperties": false, "required": ["address", "username", "fromAddress", "allowInsecureLocal"], "properties": {"address": {"type": "string", "minLength": 3}, "username": {"type": "string"}, "fromAddress": {"type": "string", "minLength": 3}, "allowInsecureLocal": {"type": "boolean"}}},
        "bootstrap": {"type": "object", "additionalProperties": false, "required": ["enabled", "rotateExistingPassword", "secretName", "usernameKey", "emailKey", "passwordKey", "databaseKey"], "properties": {"enabled": {"type": "boolean"}, "rotateExistingPassword": {"type": "boolean"}, "secretName": {"type": "string", "minLength": 1}, "usernameKey": {"type": "string", "minLength": 1}, "emailKey": {"type": "string", "minLength": 1}, "passwordKey": {"type": "string", "minLength": 1}, "databaseKey": {"type": "string", "minLength": 1}}},
        "publicConfig": {"type": "object", "additionalProperties": false, "required": ["pollingIntervalSeconds", "mapFitPaddingPixels", "baseMaps"], "properties": {"pollingIntervalSeconds": {"type": "integer", "minimum": 1}, "mapFitPaddingPixels": {"type": "integer", "minimum": 0}, "baseMaps": {"$ref": "#/$defs/baseMaps"}}},
        "resources": {"type": "object"}
      }
    },
    "worker": {"type": "object", "additionalProperties": false, "required": ["image", "replicas", "databaseSecret", "osmDatabaseKey", "databaseTLSSecret", "fileConcurrency", "accountFileConcurrency", "globalFileConcurrency", "autoSyncInterval", "autoSyncPollInterval", "autoSyncStaleDays", "schedulerLeaseDuration", "coverageMinTraversalMeters", "staging", "resources"], "properties": {"image": {"type": "string", "minLength": 1}, "replicas": {"type": "integer", "minimum": 1}, "databaseSecret": {"$ref": "#/$defs/secretRef"}, "osmDatabaseKey": {"type": "string", "minLength": 1}, "databaseTLSSecret": {"type": "string", "minLength": 1}, "fileConcurrency": {"type": "integer", "minimum": 1, "maximum": 16}, "accountFileConcurrency": {"type": "integer", "minimum": 1, "maximum": 16}, "globalFileConcurrency": {"type": "integer", "minimum": 1, "maximum": 16}, "autoSyncInterval": {"type": "string", "pattern": "^(([5-9]|[1-9][0-9]{1,3})m|([1-9]|[1-9][0-9]|1[0-5][0-9]|16[0-8])h)$"}, "autoSyncPollInterval": {"type": "string", "pattern": "^(([1-9]|[1-9][0-9]|[12][0-9]{2}|300)s|[1-5]m)$"}, "autoSyncStaleDays": {"type": "integer", "minimum": 1, "maximum": 30}, "schedulerLeaseDuration": {"type": "string", "pattern": "^(([1-9]|[1-9][0-9]|[1-8][0-9]{2}|900)s|([1-9]|1[0-5])m)$"}, "coverageMinTraversalMeters": {"type": "number", "minimum": 0.1, "maximum": 100}, "staging": {"type": "object", "additionalProperties": false, "required": ["root", "sizeLimit"], "properties": {"root": {"type": "string", "pattern": "^/[^,]+$"}, "sizeLimit": {"type": "string", "pattern": "^[1-9][0-9]*(Ki|Mi|Gi|Ti)$"}}}, "resources": {"type": "object"}}},
    "coverageWorker": {"type": "object", "additionalProperties": false, "required": ["image", "replicas", "databaseSecret", "osmDatabaseKey", "databaseTLSSecret", "pollInterval", "admissionInterval", "leaseDuration", "heartbeatInterval", "routeTimeout", "reconciliationPollInterval", "reconciliationScanInterval", "reconciliationPageSize", "resources"], "properties": {"image": {"type": "string", "minLength": 1}, "replicas": {"type": "integer", "minimum": 1}, "databaseSecret": {"$ref": "#/$defs/secretRef"}, "osmDatabaseKey": {"type": "string", "minLength": 1}, "databaseTLSSecret": {"type": "string", "minLength": 1}, "pollInterval": {"type": "string", "pattern": "^[1-9][0-9]*(ms|s|m)$"}, "admissionInterval": {"type": "string", "pattern": "^[1-9][0-9]*(ms|s|m)$"}, "leaseDuration": {"type": "string", "pattern": "^[1-9][0-9]*(s|m)$"}, "heartbeatInterval": {"type": "string", "pattern": "^[1-9][0-9]*(s|m)$"}, "routeTimeout": {"type": "string", "pattern": "^[1-9][0-9]*(s|m)$"}, "reconciliationPollInterval": {"type": "string", "pattern": "^[1-9][0-9]*(s|m)$"}, "reconciliationScanInterval": {"type": "string", "pattern": "^[1-9][0-9]*h$"}, "reconciliationPageSize": {"type": "integer", "minimum": 1, "maximum": 100}, "resources": {"type": "object"}}},
    "osm": {"type": "object", "additionalProperties": false, "required": ["autoAddRegions", "maxAutoDownloadBytes", "dataProviders", "regions", "timezoneBoundaries"], "properties": {"autoAddRegions": {"type": "boolean"}, "maxAutoDownloadBytes": {"type": "integer", "minimum": 1, "maximum": 1099511627776}, "dataProviders": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"}}, "regions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}:[a-z][a-z0-9-]{0,63}$"}}, "timezoneBoundaries": {"type": "object", "additionalProperties": false, "required": ["enabled", "release", "sourceUrl", "sha256"], "properties": {"enabled": {"type": "boolean"}, "release": {"type": "string", "minLength": 1, "maxLength": 128}, "sourceUrl": {"type": "string", "pattern": "^https://[^[:space:]\"';]+$"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}}}},
    "sources": {"type": "object", "additionalProperties": false, "required": ["keyringSecret", "localRoots", "nfs"], "properties": {"keyringSecret": {"$ref": "#/$defs/secretRef"}, "localRoots": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^/[^,]+$"}}, "nfs": {"type": "object", "additionalProperties": false, "required": ["enabled", "server", "path", "mountPath", "supplementalGroup"], "properties": {"enabled": {"type": "boolean"}, "server": {"type": "string"}, "path": {"type": "string"}, "mountPath": {"type": "string", "pattern": "^/"}, "supplementalGroup": {"type": "integer", "minimum": 1}}}}},
    "otel": {"type": "object", "additionalProperties": false, "required": ["endpoint"], "properties": {"endpoint": {"type": "string"}}},
    "ingress": {"type": "object", "additionalProperties": false, "required": ["enabled", "className", "annotations", "host", "additionalHosts", "tlsSecretName", "certificateSecretName"], "properties": {"enabled": {"type": "boolean"}, "className": {"type": "string"}, "annotations": {"type": "object", "additionalProperties": {"type": "string"}}, "host": {"type": "string"}, "additionalHosts": {"type": "array", "maxItems": 15, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "tlsSecretName": {"type": "string", "minLength": 1}, "certificateSecretName": {"type": "string", "minLength": 1}}}
  },
  "$defs": {
    "component": {"type": "object", "additionalProperties": false, "required": ["image", "replicas", "resources"], "properties": {"image": {"type": "string", "minLength": 1}, "replicas": {"type": "integer", "minimum": 1}, "resources": {"type": "object"}}},
    "baseMaps": {"type": "object", "additionalProperties": false, "required": ["styleFamilies", "fallbackFamilyId", "workoutTypeMappings"], "properties": {"styleFamilies": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/baseMapFamily"}}, "fallbackFamilyId": {"type": "string", "pattern": "^[a-z](?:[a-z0-9-]{0,62}[a-z0-9])?$"}, "workoutTypeMappings": {"type": "array", "maxItems": 256, "items": {"type": "object", "additionalProperties": false, "required": ["providerLabel", "familyId"], "properties": {"providerLabel": {"type": "string", "minLength": 1, "maxLength": 4096}, "familyId": {"type": "string", "pattern": "^[a-z](?:[a-z0-9-]{0,62}[a-z0-9])?$"}}}}}},
    "baseMapFamily": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "styles", "attribution", "resourceOrigins"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z](?:[a-z0-9-]{0,62}[a-z0-9])?$"},
        "label": {"type": "string", "minLength": 1, "maxLength": 128},
        "styles": {
          "type": "object",
          "additionalProperties": false,
          "required": ["light", "dark"],
          "properties": {
            "light": {"type": "string", "pattern": "^https://[^[:space:]\"';]+$"},
            "dark": {"type": "string", "pattern": "^https://[^[:space:]\"';]+$"}
          }
        },
        "attribution": {
          "type": "object",
          "additionalProperties": false,
          "required": ["text", "links"],
          "properties": {
            "text": {"type": "string", "minLength": 1, "maxLength": 1024},
            "links": {
              "type": "array",
              "maxItems": 16,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["label", "url"],
                "properties": {
                  "label": {"type": "string", "minLength": 1, "maxLength": 128},
                  "url": {"type": "string", "pattern": "^https://[^[:space:]\"';]+$"}
                }
              }
            }
          }
        },
        "resourceOrigins": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^https://[A-Za-z0-9.-]+(?::[0-9]{1,5})?$"}
        }
      }
    },
    "secretRef": {"type": "object", "additionalProperties": false, "required": ["name", "key"], "properties": {"name": {"type": "string", "minLength": 1}, "key": {"type": "string", "minLength": 1}}}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["image", "ui", "api", "worker", "otel", "ingress"],
  "properties": {
    "image": {"type": "object", "additionalProperties": false, "required": ["registry", "pullPolicy", "pullSecrets", "tag"], "properties": {"registry": {"type": "string"}, "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]}, "pullSecrets": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["name"], "properties": {"name": {"type": "string", "minLength": 1}}}}, "tag": {"type": "string"}}},
    "ui": {"$ref": "#/$defs/component"},
    "api": {
      "type": "object", "additionalProperties": false,
      "required": ["image", "replicas", "publicUrl", "databaseSecret", "migrationDatabaseKey", "roleProvisioning", "securitySecret", "passwordMinimumLength", "sessionLifetime", "pageSizeMaximum", "trustedProxyCidrs", "localDevelopment", "smtp", "bootstrap", "publicConfig", "resources"],
      "properties": {
        "image": {"type": "string", "minLength": 1}, "replicas": {"type": "integer", "minimum": 1}, "publicUrl": {"type": "string", "format": "uri"},
        "databaseSecret": {"$ref": "#/$defs/secretRef"}, "migrationDatabaseKey": {"type": "string", "minLength": 1},
        "roleProvisioning": {"type": "object", "additionalProperties": false, "required": ["enabled", "secretName", "databaseKey"], "properties": {"enabled": {"type": "boolean"}, "secretName": {"type": "string", "minLength": 1}, "databaseKey": {"type": "string", "minLength": 1}}},
        "securitySecret": {"type": "object", "additionalProperties": false, "required": ["name", "rateLimitKey", "smtpPasswordKey"], "properties": {"name": {"type": "string", "minLength": 1}, "rateLimitKey": {"type": "string", "minLength": 1}, "smtpPasswordKey": {"type": "string", "minLength": 1}}},
        "passwordMinimumLength": {"type": "integer", "minimum": 12, "maximum": 64}, "sessionLifetime": {"type": "string", "pattern": "^[1-9][0-9]*(m|h)$"}, "pageSizeMaximum": {"type": "integer", "minimum": 25, "maximum": 1000}, "trustedProxyCidrs": {"type": "string"}, "localDevelopment": {"type": "boolean"},
        "smtp": {"type": "object", "additionalProperties": false, "required": ["address", "username", "fromAddress", "allowInsecureLocal"], "properties": {"address": {"type": "string", "minLength": 3}, "username": {"type": "string"}, "fromAddress": {"type": "string", "minLength": 3}, "allowInsecureLocal": {"type": "boolean"}}},
        "bootstrap": {"type": "object", "additionalProperties": false, "required": ["enabled", "secretName", "usernameKey", "emailKey", "passwordKey", "databaseKey"], "properties": {"enabled": {"type": "boolean"}, "secretName": {"type": "string", "minLength": 1}, "usernameKey": {"type": "string", "minLength": 1}, "emailKey": {"type": "string", "minLength": 1}, "passwordKey": {"type": "string", "minLength": 1}, "databaseKey": {"type": "string", "minLength": 1}}},
        "publicConfig": {"type": "object", "additionalProperties": false, "required": ["pollingIntervalSeconds", "mapFitPaddingPixels", "baseMapTileUrl", "baseMapAttribution"], "properties": {"pollingIntervalSeconds": {"type": "integer", "minimum": 1}, "mapFitPaddingPixels": {"type": "integer", "minimum": 0}, "baseMapTileUrl": {"type": "string"}, "baseMapAttribution": {"type": "string"}}},
        "resources": {"type": "object"}
      }
    },
    "worker": {"type": "object", "additionalProperties": false, "required": ["image", "replicas", "databaseSecret", "resources"], "properties": {"image": {"type": "string", "minLength": 1}, "replicas": {"type": "integer", "minimum": 1}, "databaseSecret": {"$ref": "#/$defs/secretRef"}, "resources": {"type": "object"}}},
    "otel": {"type": "object", "additionalProperties": false, "required": ["endpoint"], "properties": {"endpoint": {"type": "string"}}},
    "ingress": {"type": "object", "additionalProperties": false, "required": ["enabled", "className", "annotations", "host", "tlsSecretName", "certificateSecretName", "mailpit"], "properties": {"enabled": {"type": "boolean"}, "className": {"type": "string"}, "annotations": {"type": "object", "additionalProperties": {"type": "string"}}, "host": {"type": "string"}, "tlsSecretName": {"type": "string", "minLength": 1}, "certificateSecretName": {"type": "string", "minLength": 1}, "mailpit": {"type": "object", "additionalProperties": false, "required": ["enabled", "externalName", "port"], "properties": {"enabled": {"type": "boolean"}, "externalName": {"type": "string", "minLength": 1}, "port": {"type": "integer", "minimum": 1, "maximum": 65535}}}}}
  },
  "$defs": {
    "component": {"type": "object", "additionalProperties": false, "required": ["image", "replicas", "resources"], "properties": {"image": {"type": "string", "minLength": 1}, "replicas": {"type": "integer", "minimum": 1}, "resources": {"type": "object"}}},
    "secretRef": {"type": "object", "additionalProperties": false, "required": ["name", "key"], "properties": {"name": {"type": "string", "minLength": 1}, "key": {"type": "string", "minLength": 1}}}
  }
}

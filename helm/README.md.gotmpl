{{- $last := last $lines -}}
{{- $previousParts := splitList "." $previous -}}
{{- if gt (len $previousParts) 1 -}}
{{- $shorter := join "." (initial $previousParts) -}}
{{- $longer := printf "%s.%s" (last $previousParts) $last -}}
{{- $before := sub (add (len $previous) 1) (len $last) -}}
{{- $after := sub (add (len $shorter) 1) (len $longer) -}}
{{- if and (le (len $longer) 30) (lt (mul $after $after) (mul $before $before)) -}}
{{- $lines = append (append (initial $prefix) $shorter) $longer -}}
{{- end -}}
